# Configuración del backend de tu aplicación.
# Estas claves nunca van a NEXT_PUBLIC_* ni al navegador.
PAYMENT_PROCESSOR_URL=http://localhost:8000
# Una de las SAAS_API_KEYS del procesador; NO la clave API de SumUp.
PAYMENT_PROCESSOR_API_KEY=
# Debe coincidir con SAAS_WEBHOOK_SECRET del procesador.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_EXPECTED_MERCHANT_CODE=
# Registrar exactamente esta URL en los retornos permitidos del procesador.
PAYMENT_RETURN_URL=http://localhost:3000/payments/return
