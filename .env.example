# Copy to .env; never commit secrets. Generate each secret independently.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=payments.example.com
CSRF_TRUSTED_ORIGINS=https://payments.example.com
PUBLIC_BASE_URL=https://payments.example.com
TRUST_PROXY=true
APP_DOMAIN=payments.example.com
APP_PORT=8000
POSTGRES_DB=sumup
POSTGRES_USER=sumup
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
SUMUP_API_KEY=
# Keep charges paused until the installation and integration are configured.
PAYMENT_CREATION_ENABLED=false
RECURRING_CHARGES_ENABLED=false
# Fernet key: preserve it with your encrypted backups; do not regenerate on updates.
PAYMENT_TOKEN_ENCRYPTION_KEY=
SUMUP_MERCHANT_CODE=
# Sandbox requires explicit confirmation from SumUp; set false only for a live merchant.
SUMUP_SANDBOX_ONLY=true
SUMUP_WEBHOOK_ENABLED=true
# Backend credentials, at least 32 characters each. Comma-separated for key rotation.
SAAS_API_KEYS=
SAAS_WEBHOOK_SECRET=
